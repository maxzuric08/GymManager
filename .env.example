# PostgreSQL (used by the database container)
POSTGRES_DB=gymmanager
POSTGRES_USER=gymmanager
POSTGRES_PASSWORD=replace_with_a_local_password

# Database access when the backend runs outside Docker. Compose supplies its own
# values so that the backend connects to the `db` service.
DB_USER=gymmanager
DB_HOST=localhost
DB_NAME=gymmanager
DB_PASSWORD=replace_with_a_local_password
DB_PORT=5432

# API exposed on the host
BACKEND_PORT=3000

# Backend security and integrations
JWT_SECRET=replace_with_a_long_random_secret
EMAIL_USER=
EMAIL_PASSWORD=
APP_URL=http://localhost:3000
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:3000

# IA para recomendaciones (solo backend)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
